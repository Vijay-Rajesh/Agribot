# Primary AI provider (used first by Chainlit and WhatsApp).
OPENAI_API_KEY=your-openai-api-key

# Optional fallback providers.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=

# WhatsApp Cloud API. Add the Meta App Secret; it is required to validate
# incoming webhook signatures.
VERIFY_TOKEN=choose-a-private-webhook-verification-token
META_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_DATABASE_PATH=.files/whatsapp.sqlite3

# Optional weather lookups.
WEATHER_API_KEY=

# Optional for satellite analysis in a hosted environment; mount the file as a
# secret and set this variable to its in-container path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/earthengine-service-account.json

# The combined Chainlit + WhatsApp server is the default.
APP_SERVICE=all
PORT=8000
